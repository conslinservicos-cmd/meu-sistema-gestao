<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<style>
    @page { size: A4; margin: 15mm; }
    body { font-family: Arial, sans-serif; color: #2d3748; font-size: 10pt; margin: 0; }
    .header { border-bottom: 2px solid #2b6cb0; padding-bottom: 10px; margin-bottom: 20px; }
    .brand-title { font-size: 18pt; font-weight: bold; color: #1a365d; }
    .brand-subtitle { font-size: 9pt; color: #718096; }
    .info-card { background-color: #f7fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 12px; margin-bottom: 20px; }
    .section-title { font-size: 12pt; font-weight: bold; color: #2b6cb0; border-left: 4px solid #2b6cb0; padding-left: 8px; margin: 20px 0 15px 0; }
    .photo-grid { width: 100%; border-collapse: separate; border-spacing: 15px; }
    .photo-card { width: 50%; vertical-align: top; background: #fff; border: 1px solid #cbd5e0; border-radius: 6px; padding: 8px; page-break-inside: avoid; }
    .photo-img { width: 100%; height: 200px; object-fit: cover; border-radius: 4px; }
    .photo-caption { font-size: 8.5pt; color: #4a5568; margin-top: 6px; padding: 4px; background: #f7fafc; border-radius: 4px; }
</style>
</head>
<body>

<div class="header">
    <div class="brand-title"><%= empresa.nome %></div>
    <div class="brand-subtitle"><%= empresa.subtitulo %> • CNPJ: <%= empresa.cnpj %></div>
</div>

<div class="info-card">
    <div style="font-size: 14pt; font-weight: bold; color: #1a365d; margin-bottom: 8px;"><%= relatorio.titulo %></div>
    <div><strong>Cliente:</strong> <%= relatorio.cliente %> | <strong>Data:</strong> <%= relatorio.data %></div>
    <div><strong>Local:</strong> <%= relatorio.local %></div>
</div>

<div class="section-title">Registro Fotográfico</div>

<table class="photo-grid">
    <% for(let i = 0; i < fotos.length; i += 2) { %>
        <tr>
            <td class="photo-card">
                <img src="<%= fotos[i].src %>" class="photo-img">
                <div class="photo-caption"><strong>Reg. #<%= i + 1 %>:</strong> <%= fotos[i].legenda %></div>
            </td>
            <% if (fotos[i + 1]) { %>
                <td class="photo-card">
                    <img src="<%= fotos[i + 1].src %>" class="photo-img">
                    <div class="photo-caption"><strong>Reg. #<%= i + 2 %>:</strong> <%= fotos[i + 1].legenda %></div>
                </td>
            <% } else { %>
                <td style="width: 50%;"></td>
            <% } %>
        </tr>
    <% } %>
</table>

<div class="section-title">Considerações Técnicas</div>
<p style="font-size: 9.5pt; background: #fffaf0; padding: 12px; border: 1px solid #feebc8; border-radius: 6px;">
    <%= relatorio.observacoes %>
</p>

</body>
</html>
